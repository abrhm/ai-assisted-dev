{
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx .claude/hooks/logHook.ts"
          },
          {
            "type": "command",
            "command": "npx tsx .claude/hooks/prettier.ts"
          },
          {
            "type": "command",
            "command": "npx tsx .claude/hooks/eslint.ts"
          }
        ]
      }
    ]
  }
}
